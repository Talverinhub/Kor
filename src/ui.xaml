<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kor" Width="440" Height="860" Background="#000000"
        MinWidth="300" MinHeight="200" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Bahnschrift" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Window.TaskbarItemInfo>
    <TaskbarItemInfo/>
  </Window.TaskbarItemInfo>
  <Window.Resources>
    <Style x:Key="FocusLine">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-2" RadiusX="6" RadiusY="6" Stroke="#F4F1EA" StrokeThickness="1.5"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Geometry x:Key="UpGeo">M0,7 L7,0 L14,7</Geometry>
    <Geometry x:Key="DownGeo">M0,0 L7,7 L14,0</Geometry>
    <SolidColorBrush x:Key="Gold" Color="#D8C49A"/>
    <SolidColorBrush x:Key="Soft" Color="#8E8A82"/>

    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Foreground" Value="#8E8A82"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusLine}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="44" Height="44" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1C1C1C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Arrow" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Delay" Value="350"/>
      <Setter Property="Interval" Value="70"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" Height="30" Width="76">
              <Path x:Name="p" Data="{TemplateBinding Tag}" Stroke="#9A958C" StrokeThickness="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="p" Property="Stroke" Value="#D8C49A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="Border">
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="76"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="#D8C49A"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Digit" TargetType="TextBlock">
      <Setter Property="FontSize" Value="56"/>
      <Setter Property="FontWeight" Value="Light"/>
      <Setter Property="Foreground" Value="#F4F1EA"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Colon" TargetType="TextBlock" BasedOn="{StaticResource Digit}">
      <Setter Property="Foreground" Value="#5A5750"/>
      <Setter Property="FontSize" Value="44"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,0,26"/>
    </Style>
    <Style x:Key="Unit" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#8E8A82"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Preset" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusLine}"/>
      <Setter Property="Foreground" Value="#B5B0A6"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="5,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="16" Height="32" Padding="16,0" BorderThickness="1" BorderBrush="#2B2A27" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#D8C49A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusLine}"/>
      <Setter Property="Foreground" Value="#000000"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="28" Height="56" Background="#D8C49A">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#EBDBB8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#BFAB82"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="#1E1D1B"/>
                <Setter Property="Foreground" Value="#6E6A63"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusLine}"/>
      <Setter Property="Foreground" Value="#D8C49A"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="28" Height="56" BorderThickness="1" BorderBrush="#3A3832" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#D8C49A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BarPart" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent"><Border Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}"/></Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Thin" TargetType="Slider">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusLine}"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent" Height="16">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource BarPart}" Background="#D8C49A" Command="Slider.DecreaseLarge"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource BarPart}" Background="#34322D" Command="Slider.IncreaseLarge"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Focusable="False" Width="10" Height="10">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb"><Ellipse Fill="#F4F1EA"/></ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Media" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusLine}"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="34" Height="34" CornerRadius="17" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1E1D1B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MediaMain" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusLine}"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="38" Height="38" CornerRadius="19" Background="#F4F1EA">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#D8C49A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Background" Value="#141413"/>
      <Setter Property="Foreground" Value="#F4F1EA"/>
      <Setter Property="CaretBrush" Value="#D8C49A"/>
      <Setter Property="SelectionBrush" Value="#D8C49A"/>
      <Setter Property="BorderBrush" Value="#3A3832"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="Tab" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusLine}"/>
      <Setter Property="Foreground" Value="#8E8A82"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Margin" Value="0,0,20,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0,6"><ContentPresenter/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusLine}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter/>
              <Border x:Name="track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Background="#2B2A27" Margin="12,0,0,0" VerticalAlignment="Top">
                <Ellipse x:Name="knob" Width="16" Height="16" Fill="#8E8A82" HorizontalAlignment="Left" Margin="3,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#D8C49A"/>
                <Setter TargetName="knob" Property="Fill" Value="#000000"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#3A3832"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition x:Name="SideCol" Width="0"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Button x:Name="PanelBack" AutomationProperties.Name="Geri" Style="{StaticResource Chrome}" HorizontalAlignment="Left" Visibility="Collapsed" ToolTip="Geri">
      <Path Data="M7,0 L0,6 L7,12" Stroke="#B5B0A6" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
    </Button>
    <Button x:Name="TopPlay" AutomationProperties.Name="Başlat veya duraklat" Style="{StaticResource Chrome}" HorizontalAlignment="Left" Visibility="Collapsed" ToolTip="Başlat veya duraklat">
      <Path x:Name="TopPlayIcon" Data="M0,0 L10,6 L0,12 Z" Fill="#D8C49A"/>
    </Button>
    <StackPanel x:Name="XStats" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock x:Name="XStreak" FontSize="13" Foreground="#FF7AE6"/>
      <TextBlock x:Name="XCombo" FontSize="13" Foreground="#7FF2FF" Margin="12,0,0,0"/>
      <TextBlock x:Name="XLevel" FontSize="13" Foreground="#FFE14D" Margin="12,0,0,0"/>
    </StackPanel>
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="NoteBtn" AutomationProperties.Name="Notu aç veya kapat" Style="{StaticResource Chrome}" ToolTip="Notlar">
        <Path x:Name="NoteBtnIcon" Data="M1,0.5 H8.5 L12.5,4.5 V13.5 H1 Z M8.5,0.5 V4.5 H12.5 M3.5,7.5 H10 M3.5,10.5 H7.5" Stroke="#8E8A82" StrokeThickness="1.2" StrokeLineJoin="Round"/>
      </Button>
      <Button x:Name="PanelBtn" AutomationProperties.Name="Rutinler, özet ve ayarlar" Style="{StaticResource Chrome}" ToolTip="Rutinler, özet ve ayarlar">
        <Path Data="M0,3 H8 M12,3 H14 M0,10 H2 M6,10 H14 M8,3 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M2,10 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0" Stroke="#8E8A82" StrokeThickness="1.2"/>
      </Button>
      <Button x:Name="PinBtn" AutomationProperties.Name="Mini sayaca sabitle" Style="{StaticResource Chrome}" ToolTip="Sağ üst köşeye sabitle (P)">
        <Path Data="M4,0 L10,0 M5,0 L5,6 L2,9 L12,9 L9,6 L9,0 M7,9 L7,14" Stroke="#8E8A82" StrokeThickness="1.2"/>
      </Button>
      <Button x:Name="MinBtn" AutomationProperties.Name="Küçült" Style="{StaticResource Chrome}" ToolTip="Küçült">
        <Path Data="M0,0 L11,0" Stroke="#8E8A82" StrokeThickness="1"/>
      </Button>
      <Button x:Name="CloseBtn" AutomationProperties.Name="Kapat" Style="{StaticResource Chrome}" ToolTip="Kapat">
        <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="#8E8A82" StrokeThickness="1"/>
      </Button>
    </StackPanel>

    <Viewbox x:Name="DialBox" Grid.Row="1" Margin="12,0,12,8" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
    <Grid x:Name="Dial" Width="380" Height="380">
      <Border x:Name="RingHost" Width="372" Height="372"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <RepeatButton x:Name="HUp" AutomationProperties.Name="Saati artır" Style="{StaticResource Arrow}" Tag="{StaticResource UpGeo}"/>
          <Border x:Name="HField" AutomationProperties.Name="Saat" Style="{StaticResource Field}"><TextBlock x:Name="HText" Style="{StaticResource Digit}" Text="00"/></Border>
          <RepeatButton x:Name="HDown" AutomationProperties.Name="Saati azalt" Style="{StaticResource Arrow}" Tag="{StaticResource DownGeo}"/>
          <TextBlock x:Name="U1" Style="{StaticResource Unit}" Text="saat"/>
        </StackPanel>
        <TextBlock x:Name="C1" Style="{StaticResource Colon}" Text=":"/>
        <StackPanel>
          <RepeatButton x:Name="MUp" AutomationProperties.Name="Dakikayı artır" Style="{StaticResource Arrow}" Tag="{StaticResource UpGeo}"/>
          <Border x:Name="MField" AutomationProperties.Name="Dakika" Style="{StaticResource Field}"><TextBlock x:Name="MText" Style="{StaticResource Digit}" Text="00"/></Border>
          <RepeatButton x:Name="MDown" AutomationProperties.Name="Dakikayı azalt" Style="{StaticResource Arrow}" Tag="{StaticResource DownGeo}"/>
          <TextBlock x:Name="U2" Style="{StaticResource Unit}" Text="dakika"/>
        </StackPanel>
        <TextBlock x:Name="C2" Style="{StaticResource Colon}" Text=":"/>
        <StackPanel>
          <RepeatButton x:Name="SUp" AutomationProperties.Name="Saniyeyi artır" Style="{StaticResource Arrow}" Tag="{StaticResource UpGeo}"/>
          <Border x:Name="SField" AutomationProperties.Name="Saniye" Style="{StaticResource Field}"><TextBlock x:Name="SText" Style="{StaticResource Digit}" Text="00"/></Border>
          <RepeatButton x:Name="SDown" AutomationProperties.Name="Saniyeyi azalt" Style="{StaticResource Arrow}" Tag="{StaticResource DownGeo}"/>
          <TextBlock x:Name="U3" Style="{StaticResource Unit}" Text="saniye"/>
        </StackPanel>
      </StackPanel>
    </Grid>
    </Viewbox>
    <Grid x:Name="FocusView" Grid.Row="1" Visibility="Collapsed" Margin="32,0,32,8">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Şu an" FontSize="13" Foreground="#8E8A82"/>
        <TextBlock x:Name="FocusTask" FontSize="24" Foreground="#F4F1EA" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <Viewbox StretchDirection="DownOnly" Margin="0,22,0,14" Height="96">
          <TextBlock x:Name="FocusTime" FontSize="84" FontWeight="Light" Foreground="#F4F1EA"/>
        </Viewbox>
        <UniformGrid x:Name="FocusParts" Rows="1" Columns="5" Height="10"/>
        <TextBlock x:Name="FocusLeft" FontSize="14" Foreground="#8E8A82" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        <Border x:Name="FocusNextBox" CornerRadius="10" Background="#1E1D1B" Padding="14,10" Margin="0,20,0,0" Visibility="Collapsed">
          <TextBlock x:Name="FocusNext" FontSize="14" Foreground="#B5B0A6" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </Grid>

    <Grid x:Name="StatusRow" Grid.Row="2" MinHeight="56">
      <StackPanel VerticalAlignment="Center">
      <StackPanel x:Name="ModeBar" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
        <Button x:Name="ModeTimer" Style="{StaticResource Tab}" Margin="10,0" Content="Sayaç"/>
        <Button x:Name="ModeWatch" Style="{StaticResource Tab}" Margin="10,0" Content="Kronometre"/>
        <Button x:Name="ModeSongs" Style="{StaticResource Tab}" Margin="10,0" Content="Şarkı"/>
      </StackPanel>
      <Button x:Name="UndoBtn" Style="{StaticResource Preset}" HorizontalAlignment="Center" Margin="0,0,0,8" Content="Sıfırlamayı geri al" Visibility="Collapsed"/>
      <StackPanel x:Name="NoticeRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="32,0,32,8" Visibility="Collapsed">
        <TextBlock x:Name="Notice" FontSize="13" Foreground="#D8C49A" TextWrapping="Wrap" MaxWidth="320" VerticalAlignment="Center"/>
        <Button x:Name="NoticeClose" AutomationProperties.Name="Notu kapat" Style="{StaticResource Tab}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" Content="✕"/>
      </StackPanel>
      <Button x:Name="IntentAdd" Style="{StaticResource Tab}" HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,4" Content="+ Ne yapıyorsun?"/>
      <StackPanel x:Name="SongBar" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
        <Button x:Name="SongLess" AutomationProperties.Name="Şarkı sayısını azalt" Style="{StaticResource Preset}" Content="−"/>
        <TextBlock x:Name="SongText" FontSize="15" Foreground="#F4F1EA" VerticalAlignment="Center" Margin="10,0"/>
        <Button x:Name="SongMore" AutomationProperties.Name="Şarkı sayısını artır" Style="{StaticResource Preset}" Content="+"/>
      </StackPanel>
      <Grid x:Name="IntentRow" Margin="40,0,40,8">
        <TextBox x:Name="IntentBox" Style="{StaticResource Input}" Margin="0" FontSize="14"/>
        <TextBlock x:Name="IntentHint" Text="Ne yapıyorsun?" FontSize="14" Foreground="#A8A399" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <StackPanel x:Name="Presets" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      </StackPanel>
      <WrapPanel x:Name="RoutineBar" HorizontalAlignment="Center" Margin="24,8,24,0" ItemHeight="40"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="IntentLabel" FontSize="14" Foreground="#B5B0A6" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="32,0,32,6" Visibility="Collapsed"/>
      <StackPanel x:Name="StatusBox" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock x:Name="Status" FontSize="15" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="AddOne" Style="{StaticResource Preset}" Content="+1 dk"/>
        <Button x:Name="AddFive" Style="{StaticResource Preset}" Content="+5 dk"/>
        <Button x:Name="SnoozeBtn" Style="{StaticResource Preset}" Content="5 dk ertele"/>
        <Button x:Name="AskYes" Style="{StaticResource Preset}" Content="Evet"/>
        <Button x:Name="AskNo" Style="{StaticResource Preset}" Content="Hayır"/>
      </StackPanel>
      <Grid x:Name="NoteRow" Margin="40,8,40,0" Visibility="Collapsed">
        <TextBox x:Name="NoteBox" Style="{StaticResource Input}" Margin="0" FontSize="14"/>
        <TextBlock x:Name="NoteHint" Text="Nerede kaldım?" FontSize="14" Foreground="#A8A399" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      </StackPanel>
    </Grid>

    <Grid x:Name="BottomRow" Grid.Row="3" Margin="40,10,40,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="GapCol" Width="0"/>
        <ColumnDefinition x:Name="SecCol" Width="0"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="MainBtn" Style="{StaticResource Primary}" Content="Başlat"/>
      <Button x:Name="ResetBtn" Grid.Column="2" Style="{StaticResource Secondary}" Content="Sıfırla"/>
    </Grid>

    <Grid x:Name="SpotifyRow" Grid.Row="4" Grid.ColumnSpan="2" Margin="24,0,24,14">
      <Button x:Name="SpConnect" Style="{StaticResource Secondary}" Margin="16,0" Content="Spotify'a bağlan"/>
      <StackPanel x:Name="SpPlayer" Visibility="Collapsed" Background="Transparent" VerticalAlignment="Center">
        <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="SpInfo">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="46" Height="46" Background="#1E1D1B">
            <Image x:Name="SpCover" Stretch="UniformToFill"/>
          </Border>
          <StackPanel x:Name="SpText" Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <TextBlock x:Name="SpTitle" Text="Spotify yükleniyor" FontSize="15" Foreground="#F4F1EA" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SpArtist" FontSize="13" Foreground="#8E8A82" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel x:Name="SpVolumeBox" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M0,4 H3 L7,0 V12 L3,8 H0 Z" Fill="#8E8A82" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Slider x:Name="SpVolume" AutomationProperties.Name="Ses" Style="{StaticResource Thin}" Width="72" Minimum="0" Maximum="100" ToolTip="Ses"/>
          </StackPanel>
        </Grid>
        <StackPanel x:Name="SpControls" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,2">
          <Button x:Name="SpLike" AutomationProperties.Name="Beğen" Style="{StaticResource Media}" ToolTip="Beğendiklerime ekle veya çıkar">
            <Path x:Name="SpLikeIcon" Data="M7,12 C2,8 0,6 0,3.5 C0,1.5 1.5,0 3.5,0 C5,0 6.2,0.8 7,2 C7.8,0.8 9,0 10.5,0 C12.5,0 14,1.5 14,3.5 C14,6 12,8 7,12 Z" Stroke="#8E8A82" StrokeThickness="1.2"/>
          </Button>
          <Button x:Name="SpShuffle" AutomationProperties.Name="Karışık çal" Style="{StaticResource Media}" ToolTip="Karışık çal">
            <Path x:Name="SpShuffleIcon" Data="M0,3 H3 L10,11 H14 M0,11 H3 L10,3 H14 M12,1 L14,3 L12,5 M12,9 L14,11 L12,13" Stroke="#8E8A82" StrokeThickness="1.3"/>
          </Button>
          <Button x:Name="SpPrev" AutomationProperties.Name="Önceki şarkı" Style="{StaticResource Media}" ToolTip="Önceki şarkı">
            <Path Data="M0,0 H2 V12 H0 Z M12,0 V12 L3,6 Z" Fill="#F4F1EA"/>
          </Button>
          <Button x:Name="SpPlay" AutomationProperties.Name="Oynat veya duraklat" Style="{StaticResource MediaMain}" ToolTip="Oynat veya duraklat">
            <Path x:Name="SpPlayIcon" Data="M0,0 L10,6 L0,12 Z" Fill="#000000"/>
          </Button>
          <Button x:Name="SpNext" AutomationProperties.Name="Sonraki şarkı" Style="{StaticResource Media}" ToolTip="Sonraki şarkı">
            <Path Data="M0,0 L9,6 L0,12 Z M10,0 H12 V12 H10 Z" Fill="#F4F1EA"/>
          </Button>
          <Button x:Name="SpRepeat" AutomationProperties.Name="Tekrar" Style="{StaticResource Media}" ToolTip="Tekrar">
            <Grid>
              <Path x:Name="SpRepeatIcon" Data="M2,7 V4 H13 M11,2 L13,4 L11,6 M13,7 V10 H2 M4,8 L2,10 L4,12" Stroke="#8E8A82" StrokeThickness="1.3"/>
              <TextBlock x:Name="SpRepeatOne" Text="1" FontSize="8" Foreground="#D8C49A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Button>
        </StackPanel>
        </Grid>
        <Grid x:Name="SpSeekRow">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="38"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SpPos" Text="0:00" FontSize="12" Foreground="#8E8A82" VerticalAlignment="Center"/>
          <Slider x:Name="SpSeek" AutomationProperties.Name="Şarkı konumu" Grid.Column="1" Style="{StaticResource Thin}" Minimum="0" Maximum="1" ToolTip="Şarkıda ileri geri sar"/>
          <TextBlock x:Name="SpDur" Grid.Column="2" Text="0:00" FontSize="12" Foreground="#8E8A82" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </StackPanel>
    </Grid>

    <Grid x:Name="PanelOverlay" Grid.Row="1" Grid.RowSpan="4" Grid.ColumnSpan="2" Background="#000000" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="24,0,24,10">
        <Button x:Name="TabRoutines" Style="{StaticResource Tab}" Content="Rutinler"/>
        <Button x:Name="TabStats" Style="{StaticResource Tab}" Content="Özet"/>
        <Button x:Name="TabSettings" Style="{StaticResource Tab}" Content="Ayarlar"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="PanelBody" Margin="24,4,24,20"/>
      </ScrollViewer>
    </Grid>

    <Grid x:Name="IntroOverlay" Grid.RowSpan="5" Grid.ColumnSpan="2" Background="Transparent" Visibility="Collapsed">
      <Path x:Name="IntroDim" Fill="#D6000000"/>
      <Path x:Name="IntroRing" Stroke="#D8C49A" StrokeThickness="1.5" IsHitTestVisible="False"/>
      <Canvas>
      <Border x:Name="IntroCard" Width="340" Padding="22,20" CornerRadius="16" Background="#141311" BorderBrush="#2B2A27" BorderThickness="1">
        <StackPanel>
          <Grid>
            <StackPanel x:Name="IntroDots" Orientation="Horizontal" VerticalAlignment="Center"/>
            <Button x:Name="IntroSkip" Style="{StaticResource Preset}" HorizontalAlignment="Right" Padding="12,4" FontSize="13" Content="Rehberi kapat"/>
          </Grid>
          <TextBlock x:Name="IntroTitle" FontSize="24" FontWeight="Light" Foreground="#F4F1EA" Margin="0,14,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="IntroAction" FontSize="15" FontWeight="SemiBold" Foreground="#D8C49A" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="IntroText" FontSize="15" Foreground="#B5B0A6" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="22"/>
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="IntroBack" Style="{StaticResource Secondary}" FontSize="15" Content="Geri"/>
            <Button x:Name="IntroNext" Grid.Column="2" Style="{StaticResource Primary}" FontSize="15" Content="İleri"/>
          </Grid>
        </StackPanel>
      </Border>
      </Canvas>
    </Grid>

    <Grid x:Name="CloseOverlay" Grid.RowSpan="5" Grid.ColumnSpan="2" Background="#E6000000" Visibility="Collapsed">
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16">
      <StackPanel Width="376">
        <TextBlock Text="Kor kapatılsın mı?" FontSize="26" FontWeight="Light" Foreground="#F4F1EA" TextWrapping="Wrap"/>
        <TextBlock x:Name="CloseText" FontSize="15" Foreground="#B5B0A6" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Button x:Name="CloseTray" Style="{StaticResource Primary}" Margin="0,20,0,0" Content="Sistem tepsisine indir"/>
        <Button x:Name="CloseExit" Style="{StaticResource Secondary}" Margin="0,10,0,0" Content="Tamamen kapat"/>
        <CheckBox x:Name="CloseRemember" Style="{StaticResource Switch}" Margin="0,16,0,0">
          <TextBlock Text="Seçimimi hatırla, bir daha sorma" FontSize="14" Foreground="#F4F1EA"/>
        </CheckBox>
        <Button x:Name="CloseCancel" Style="{StaticResource Preset}" HorizontalAlignment="Center" Margin="0,14,0,0" Content="Vazgeç"/>
      </StackPanel>
      </Viewbox>
    </Grid>

    <Grid x:Name="UpdateOverlay" Grid.RowSpan="5" Grid.ColumnSpan="2" Background="#E6000000" Visibility="Collapsed">
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16">
      <StackPanel Width="376">
        <TextBlock Text="Güncelleme hazır" FontSize="26" FontWeight="Light" Foreground="#F4F1EA"/>
        <TextBlock x:Name="UpdateText" FontSize="15" Foreground="#B5B0A6" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Button x:Name="UpdateNow" Style="{StaticResource Primary}" Margin="0,20,0,0" Content="Şimdi kur ve yeniden başlat"/>
        <Button x:Name="UpdateLater" Style="{StaticResource Secondary}" Margin="0,10,0,0" Content="Sonra"/>
      </StackPanel>
      </Viewbox>
    </Grid>

    <Grid x:Name="ConnectOverlay" Grid.RowSpan="5" Grid.ColumnSpan="2" Background="#E6000000" Visibility="Collapsed">
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16">
      <StackPanel Width="376">
        <TextBlock Text="TalverinConnect bağlansın mı?" FontSize="26" FontWeight="Light" Foreground="#F4F1EA" TextWrapping="Wrap"/>
        <TextBlock Text="Bir tarayıcı eklentisi müziğini Kor'da göstermek ve yönetmek istiyor. Yalnızca TalverinConnect'i sen kurduysan izin ver." FontSize="15" Foreground="#B5B0A6" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Button x:Name="ConnectAllow" Style="{StaticResource Primary}" Margin="0,20,0,0" Content="İzin ver"/>
        <Button x:Name="ConnectDeny" Style="{StaticResource Secondary}" Margin="0,10,0,0" Content="Reddet"/>
      </StackPanel>
      </Viewbox>
    </Grid>
    <Canvas x:Name="FxLayer" Grid.RowSpan="5" Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True"/>
    <TextBlock x:Name="FxBig" Grid.RowSpan="5" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,120"
               FontSize="40" Foreground="#FFE14D" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"/>
  </Grid>
</Window>
