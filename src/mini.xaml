<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kor mini" Width="580" Height="128" MinWidth="300" MinHeight="66"
        Background="#000000" AllowsTransparency="True" WindowStyle="None" ResizeMode="CanResize" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" FontFamily="Bahnschrift" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Icon" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="30" Height="30" CornerRadius="15" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#262522"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="#D8C49A"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="28" Height="56" BorderThickness="1" BorderBrush="#3A3832" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#D8C49A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BarPart" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent"><Border Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}"/></Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Thin" TargetType="Slider">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent" Height="16">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource BarPart}" Background="#D8C49A" Command="Slider.DecreaseLarge"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource BarPart}" Background="#34322D" Command="Slider.IncreaseLarge"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Focusable="False" Width="10" Height="10">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb"><Ellipse Fill="#F4F1EA"/></ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Media" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="34" Height="34" CornerRadius="17" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1E1D1B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MediaMain" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="38" Height="38" CornerRadius="19" Background="#F4F1EA">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#D8C49A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ask" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="#D8C49A"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="13" Height="26" Padding="14,0" BorderThickness="1" BorderBrush="#3A3832" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#D8C49A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Viewbox Stretch="Uniform">
  <Border Width="580" Height="128" BorderBrush="#2B2A27" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="DivCol" Width="1"/>
        <ColumnDefinition x:Name="SpCol" Width="1.5*"/>
      </Grid.ColumnDefinitions>
      <Viewbox x:Name="MiniClock" Margin="14,8,6,10" Stretch="Uniform" RenderTransformOrigin="0,0">
        <Viewbox.RenderTransform>
          <ScaleTransform x:Name="MiniClockScale" ScaleX="1" ScaleY="1"/>
        </Viewbox.RenderTransform>
        <TextBlock x:Name="MiniTime" FontWeight="Light" FontSize="40" Foreground="#F4F1EA" Text="00:00"/>
      </Viewbox>
      <StackPanel x:Name="MiniAsk" VerticalAlignment="Bottom" Margin="14,0,6,10" Visibility="Collapsed" Opacity="0">
        <TextBlock Text="5 dakika daha?" FontSize="14" Foreground="#F4F1EA"/>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
          <Button x:Name="MiniYes" Style="{StaticResource Ask}" Content="Evet"/>
          <Button x:Name="MiniNo" Style="{StaticResource Ask}" Content="Hayır" Margin="6,0,0,0"/>
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="MiniPausedBox" Text="Duraklatıldı" FontSize="15" Foreground="#D8C49A" VerticalAlignment="Bottom" Margin="14,0,6,20" Visibility="Collapsed" Opacity="0"/>
      <StackPanel x:Name="MiniEnd" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="14,0,6,14" Visibility="Collapsed" Opacity="0">
        <Button x:Name="MiniFinish" Style="{StaticResource Ask}" Content="Bitir"/>
        <Button x:Name="MiniSnooze" Style="{StaticResource Ask}" Content="5 dk ertele" Margin="6,0,0,0"/>
      </StackPanel>
      <StackPanel x:Name="MiniQuick" VerticalAlignment="Bottom" Margin="14,0,6,10" Visibility="Collapsed" Opacity="0">
        <TextBlock Text="Yeniden başlat" FontSize="14" Foreground="#F4F1EA"/>
        <StackPanel x:Name="MiniQuickRow" Orientation="Horizontal" Margin="0,5,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,2">
        <Button x:Name="MiniMain" AutomationProperties.Name="Sayacı başlat veya duraklat" Style="{StaticResource Icon}" ToolTip="Başlat veya duraklat">
          <Path x:Name="MiniIcon" Fill="#D8C49A"/>
        </Button>
        <Button x:Name="MiniFade" AutomationProperties.Name="Saydamlığı değiştir" Style="{StaticResource Icon}" ToolTip="Saydamlığı değiştir">
          <Grid>
            <Ellipse Width="12" Height="12" Stroke="#8E8A82" StrokeThickness="1.3"/>
            <Path Data="M6,0 A6,6 0 0 1 6,12 Z" Fill="#8E8A82"/>
          </Grid>
        </Button>
        <Button x:Name="MiniExpand" AutomationProperties.Name="Büyük pencereyi aç" Style="{StaticResource Icon}" ToolTip="Büyük pencereyi aç">
          <Path Data="M0,4 L0,0 L4,0 M8,0 L12,0 L12,4 M12,8 L12,12 L8,12 M4,12 L0,12 L0,8" Stroke="#8E8A82" StrokeThickness="1.3"/>
        </Button>
      </StackPanel>
      <Rectangle Grid.Column="2" Fill="#2B2A27" Margin="0,12"/>
    <Grid x:Name="SpotifyRow" Grid.Column="3" Margin="12,6,12,8">
      <Button x:Name="SpConnect" Style="{StaticResource Secondary}" FontSize="14" Content="Spotify'a bağlan"/>
      <StackPanel x:Name="SpPlayer" Visibility="Collapsed" Background="Transparent" VerticalAlignment="Center">
        <Grid x:Name="SpInfo">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="46" Height="46" Background="#1E1D1B">
            <Image x:Name="SpCover" Stretch="UniformToFill"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <TextBlock x:Name="SpTitle" Text="Spotify yükleniyor" FontSize="15" Foreground="#F4F1EA" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SpArtist" FontSize="13" Foreground="#8E8A82" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel x:Name="SpVolumeBox" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M0,4 H3 L7,0 V12 L3,8 H0 Z" Fill="#8E8A82" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Slider x:Name="SpVolume" AutomationProperties.Name="Ses" Style="{StaticResource Thin}" Width="72" Minimum="0" Maximum="100" ToolTip="Ses"/>
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,2">
          <Button x:Name="SpLike" AutomationProperties.Name="Beğen" Style="{StaticResource Media}" ToolTip="Beğendiklerime ekle veya çıkar">
            <Path x:Name="SpLikeIcon" Data="M7,12 C2,8 0,6 0,3.5 C0,1.5 1.5,0 3.5,0 C5,0 6.2,0.8 7,2 C7.8,0.8 9,0 10.5,0 C12.5,0 14,1.5 14,3.5 C14,6 12,8 7,12 Z" Stroke="#8E8A82" StrokeThickness="1.2"/>
          </Button>
          <Button x:Name="SpShuffle" AutomationProperties.Name="Karışık çal" Style="{StaticResource Media}" ToolTip="Karışık çal">
            <Path x:Name="SpShuffleIcon" Data="M0,3 H3 L10,11 H14 M0,11 H3 L10,3 H14 M12,1 L14,3 L12,5 M12,9 L14,11 L12,13" Stroke="#8E8A82" StrokeThickness="1.3"/>
          </Button>
          <Button x:Name="SpPrev" AutomationProperties.Name="Önceki şarkı" Style="{StaticResource Media}" ToolTip="Önceki şarkı">
            <Path Data="M0,0 H2 V12 H0 Z M12,0 V12 L3,6 Z" Fill="#F4F1EA"/>
          </Button>
          <Button x:Name="SpPlay" AutomationProperties.Name="Oynat veya duraklat" Style="{StaticResource MediaMain}" ToolTip="Oynat veya duraklat">
            <Path x:Name="SpPlayIcon" Data="M0,0 L10,6 L0,12 Z" Fill="#000000"/>
          </Button>
          <Button x:Name="SpNext" AutomationProperties.Name="Sonraki şarkı" Style="{StaticResource Media}" ToolTip="Sonraki şarkı">
            <Path Data="M0,0 L9,6 L0,12 Z M10,0 H12 V12 H10 Z" Fill="#F4F1EA"/>
          </Button>
          <Button x:Name="SpRepeat" AutomationProperties.Name="Tekrar" Style="{StaticResource Media}" ToolTip="Tekrar">
            <Grid>
              <Path x:Name="SpRepeatIcon" Data="M2,7 V4 H13 M11,2 L13,4 L11,6 M13,7 V10 H2 M4,8 L2,10 L4,12" Stroke="#8E8A82" StrokeThickness="1.3"/>
              <TextBlock x:Name="SpRepeatOne" Text="1" FontSize="8" Foreground="#D8C49A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Button>
        </StackPanel>
        <Grid x:Name="SpSeekRow">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="38"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SpPos" Text="0:00" FontSize="12" Foreground="#8E8A82" VerticalAlignment="Center"/>
          <Slider x:Name="SpSeek" AutomationProperties.Name="Şarkı konumu" Grid.Column="1" Style="{StaticResource Thin}" Minimum="0" Maximum="1" ToolTip="Şarkıda ileri geri sar"/>
          <TextBlock x:Name="SpDur" Grid.Column="2" Text="0:00" FontSize="12" Foreground="#8E8A82" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </StackPanel>
    </Grid>
      <Rectangle x:Name="MiniBar" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom" Fill="#D8C49A" RenderTransformOrigin="1,0.5">
        <Rectangle.RenderTransform>
          <ScaleTransform x:Name="MiniScale" ScaleX="1"/>
        </Rectangle.RenderTransform>
      </Rectangle>
    </Grid>
  </Border>
  </Viewbox>
</Window>
