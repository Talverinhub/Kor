<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kor notlar" Width="320" Height="420" MinWidth="220" MinHeight="150"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" FontFamily="Bahnschrift" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Head" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="28" Height="28" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#26FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Tool" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#B5B0A6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Width="30" Height="28" CornerRadius="7" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Sep" TargetType="Rectangle">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Margin" Value="5,0"/>
      <Setter Property="Fill" Value="#33FFFFFF"/>
    </Style>
  </Window.Resources>

  <Border x:Name="NoteFrame" CornerRadius="12" Background="#141311" BorderBrush="#2B2A27" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="34"/>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid x:Name="NoteHead" Background="Transparent" Cursor="SizeAll" ToolTip="Taşımak için sürükle">
        <Border Width="34" Height="4" CornerRadius="2" Background="#3DFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
          <Button x:Name="NoteNew" Style="{StaticResource Head}" AutomationProperties.Name="Yeni not" ToolTip="Yeni not (Ctrl+T)">
            <Path Data="M6,0 V12 M0,6 H12" Stroke="#B5B0A6" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button x:Name="NoteLibrary" Style="{StaticResource Head}" AutomationProperties.Name="Tüm notlar" ToolTip="Tüm notlar">
            <Path Data="M0,1 H12 M0,6 H12 M0,11 H7" Stroke="#B5B0A6" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button x:Name="NoteColor" Style="{StaticResource Head}" AutomationProperties.Name="Not rengi" ToolTip="Not rengi">
            <Ellipse x:Name="NoteColorDot" Width="12" Height="12" Fill="#141311" Stroke="#B5B0A6" StrokeThickness="1.3"/>
          </Button>
          <Button x:Name="NoteHide" Style="{StaticResource Head}" AutomationProperties.Name="Notları gizle" ToolTip="Notları gizle (Esc)">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#B5B0A6" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>
      </Grid>

      <Grid x:Name="NoteTabRow" Grid.Row="1" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="NoteTabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="8,0,4,0">
          <StackPanel Orientation="Horizontal">
            <StackPanel x:Name="NoteTabs" Orientation="Horizontal" VerticalAlignment="Bottom"/>
            <Border x:Name="NoteNameBox" Visibility="Collapsed" Width="150" Height="26" Margin="4,0,8,4" VerticalAlignment="Center"
                    CornerRadius="7" Background="#1FFFFFFF" BorderBrush="#D8C49A" BorderThickness="1">
              <Grid>
                <TextBox x:Name="NoteName" Background="Transparent" BorderThickness="0" Foreground="#F4F1EA" CaretBrush="#D8C49A" FontSize="13"
                         VerticalContentAlignment="Center" Padding="6,0" MaxLength="40" AutomationProperties.Name="Not adı"/>
                <TextBlock x:Name="NoteNameHint" Text="Not adı, Enter" Foreground="#6E6A63" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border x:Name="NoteUndo" Grid.Column="1" Visibility="Collapsed" Height="26" Margin="0,0,10,4" VerticalAlignment="Center"
                CornerRadius="7" Background="#2A2925" Padding="10,0,4,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="NoteUndoText" Foreground="#B5B0A6" FontSize="12" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="NoteUndoBtn" Focusable="False" Cursor="Hand" Margin="8,0,0,0" AutomationProperties.Name="Geri al" ToolTip="Ctrl+Z">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="b" CornerRadius="5" Padding="8,3" Background="Transparent">
                    <TextBlock Text="Geri al" FontSize="12" FontWeight="SemiBold" Foreground="#D8C49A"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="Background" Value="#26D8C49A"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
        </Border>
        <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Margin="12,0" Fill="#26FFFFFF"/>
      </Grid>

      <Grid x:Name="NoteBody" Grid.Row="2" Margin="16,12,12,8">
        <RichTextBox x:Name="NoteText" Background="Transparent" BorderThickness="0" Foreground="#E9E4DA" CaretBrush="#D8C49A"
                     SelectionBrush="#D8C49A" SelectionOpacity="0.35" FontSize="15" FontFamily="Bahnschrift" AcceptsTab="True"
                     VerticalScrollBarVisibility="Hidden" FocusVisualStyle="{x:Null}" Padding="0" AutomationProperties.Name="Not">
          <RichTextBox.Resources>
            <Style TargetType="{x:Type Paragraph}">
              <Setter Property="Margin" Value="0,0,0,6"/>
              <Setter Property="LineHeight" Value="22"/>
            </Style>
          </RichTextBox.Resources>
        </RichTextBox>
        <TextBlock x:Name="NoteHint" Text="Bir şeyler yaz..." Foreground="#6E6A63" FontSize="15" Margin="2,0,0,0" IsHitTestVisible="False"/>
      </Grid>

      <Grid x:Name="NoteHome" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,24" MaxWidth="260">
          <Path Data="M2,1 H16 L22,7 V27 H2 Z M16,1 V7 H22 M7,13 H17 M7,18 H17 M7,23 H13" Stroke="#6E6A63" StrokeThickness="1.4" StrokeLineJoin="Round" HorizontalAlignment="Center"/>
          <TextBlock Text="Açık not yok" FontSize="20" FontWeight="Light" Foreground="#F4F1EA" HorizontalAlignment="Center" Margin="0,14,0,0"/>
          <TextBlock Text="Yeni bir not al ya da kaldığın yerden devam et." FontSize="13" Foreground="#8E8A82" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
          <Button x:Name="NoteHomeNew" Focusable="False" Cursor="Hand" HorizontalAlignment="Center" Margin="0,18,0,0" AutomationProperties.Name="Not al">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="b" CornerRadius="17" Height="34" Padding="18,0" Background="#D8C49A">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M5,0 V10 M0,5 H10" Stroke="#000000" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                    <TextBlock Text="Not al" Foreground="#000000" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="#EBDBB8"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <TextBlock x:Name="NoteHomeLabel" Text="Son notlar" FontSize="12" Foreground="#6E6A63" Margin="4,26,0,6"/>
          <StackPanel x:Name="NoteHomeList"/>
        </StackPanel>
      </Grid>

      <Border x:Name="NoteBar" Grid.Row="3" Margin="8,0,8,8" CornerRadius="10" Background="#33000000" Padding="4">
        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="NoteBold" Style="{StaticResource Tool}" AutomationProperties.Name="Kalın" ToolTip="Kalın (Ctrl+B)">
            <TextBlock Text="B" FontWeight="Bold" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="NoteItalic" Style="{StaticResource Tool}" AutomationProperties.Name="İtalik" ToolTip="İtalik (Ctrl+I)">
            <TextBlock Text="I" FontStyle="Italic" FontSize="14" FontFamily="Georgia" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="NoteMark" Style="{StaticResource Tool}" AutomationProperties.Name="Fosforlu kalem" ToolTip="Fosforlu kalem (Ctrl+H)">
            <Border Background="#8CE6B84A" CornerRadius="3" Padding="3,0">
              <TextBlock Text="ab" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Border>
          </Button>
          <Button x:Name="NoteCheck" Style="{StaticResource Tool}" AutomationProperties.Name="Yapılacaklar listesi" ToolTip="Yapılacaklar listesi">
            <Path Data="M0.5,2.5 H8.5 V10.5 H0.5 Z M2.5,6.5 L4,8 L7,4.5 M11,4 H15 M11,8 H14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Button>
          <Rectangle Style="{StaticResource Sep}"/>
          <Button x:Name="NoteSmall" Style="{StaticResource Tool}" AutomationProperties.Name="Küçük yazı" ToolTip="Küçük yazı">
            <TextBlock Text="A" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="NoteMedium" Style="{StaticResource Tool}" AutomationProperties.Name="Orta yazı" ToolTip="Orta yazı">
            <TextBlock Text="A" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="NoteLarge" Style="{StaticResource Tool}" AutomationProperties.Name="Büyük yazı" ToolTip="Büyük yazı">
            <TextBlock Text="A" FontSize="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Rectangle Style="{StaticResource Sep}"/>
          <Button x:Name="NoteLeft" Style="{StaticResource Tool}" AutomationProperties.Name="Sola yasla" ToolTip="Sola yasla (Ctrl+L)">
            <Path Data="M0,1 H12 M0,5 H8 M0,9 H12 M0,13 H8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button x:Name="NoteCenter" Style="{StaticResource Tool}" AutomationProperties.Name="Ortala" ToolTip="Ortala (Ctrl+E)">
            <Path Data="M0,1 H12 M2,5 H10 M0,9 H12 M2,13 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button x:Name="NoteRight" Style="{StaticResource Tool}" AutomationProperties.Name="Sağa yasla" ToolTip="Sağa yasla (Ctrl+R)">
            <Path Data="M0,1 H12 M4,5 H12 M0,9 H12 M4,13 H12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>
        </Viewbox>
      </Border>

      <Popup x:Name="NoteLibraryPop" PlacementTarget="{Binding ElementName=NoteLibrary}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-200">
        <Border Width="250" MaxHeight="360" CornerRadius="10" Background="#1A1917" BorderBrush="#2B2A27" BorderThickness="1" Padding="6">
          <DockPanel>
            <Border DockPanel.Dock="Top" Height="30" Margin="2,2,2,6" CornerRadius="7" Background="#14FFFFFF">
              <Grid>
                <Path Data="M5,0 A5,5 0 1 0 5,10 A5,5 0 1 0 5,0 M8.6,8.6 L12,12" Stroke="#8E8A82" StrokeThickness="1.2" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBox x:Name="NoteSearch" Background="Transparent" BorderThickness="0" Foreground="#F4F1EA" CaretBrush="#D8C49A" FontSize="13"
                         VerticalContentAlignment="Center" Padding="28,0,8,0" AutomationProperties.Name="Notlarda ara"/>
                <TextBlock x:Name="NoteSearchHint" Text="Notlarda ara" Foreground="#6E6A63" FontSize="13" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="NoteLibraryList"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Popup>
      <Popup x:Name="NoteColorPop" PlacementTarget="{Binding ElementName=NoteColor}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-120">
        <Border CornerRadius="10" Background="#1A1917" BorderBrush="#2B2A27" BorderThickness="1" Padding="8">
          <StackPanel x:Name="NoteColorList" Orientation="Horizontal"/>
        </Border>
      </Popup>
    </Grid>
  </Border>
</Window>
