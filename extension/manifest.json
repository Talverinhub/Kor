{
  "manifest_version": 3,
  "name": "TalverinConnect",
  "version": "2.2.4",
  "description": "Shows the music playing on YouTube Music in the Kor desktop app and lets you control it from there.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "core/connect.js",
        "connectors/youtube-music.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TalverinConnect",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://music.youtube.com/*"
  ]
}